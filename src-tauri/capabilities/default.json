{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:write-files",
    "fs:allow-temp-read",
    "fs:allow-temp-write",
    "fs:allow-temp-read-recursive",
    "fs:allow-temp-write-recursive"
  ]
}